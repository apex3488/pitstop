    "hero_title": {
      "ru": "МЕСТО О КОТОРОМ\nВСЕ ГОВОРЯТ",
      "uz": "HAMMA GAPIRADIGAN\nJOY",
      "en": "THE PLACE\nEVERYONE TALKS ABOUT"
    },
    "hero_text": {
      "ru": "PITSTOP — место, где auto/moto community встречается с атмосферой кафе. Еда, кофе, мотоциклы у входа и разговоры до утра. Работаем 24/7.",
      "uz": "PITSTOP — auto/moto community va cafe atmosferasi uchrashadigan joy. Taom, qahva, eshik oldidagi mototsikllar va ertalabgacha suhbat. 24/7 ochiq.",
      "en": "PITSTOP is where the auto/moto community meets café atmosphere. Food, coffee, bikes at the door, conversations until morning. Open 24/7."
    },
    "about_kicker": {
      "ru": "COMMUNITY",
      "uz": "COMMUNITY",
      "en": "COMMUNITY"
    },
    "about_title": {
      "ru": "Не просто кафе.\nТочка сбора.",
      "uz": "Shunchaki kafe emas.\nYig‘ilish nuqtasi.",
      "en": "Not just a café.\nA gathering point."
    },
    "about_text": {
      "ru": "PITSTOP объединяет auto/moto community и café atmosphere. Здесь можно заехать ночью, сесть на террасе, выпить кофе, поесть и остаться среди своих. Food. Chill. Play. Coffee. Drinks. Take away.",
      "uz": "PITSTOP auto/moto community va cafe atmosferasini birlashtiradi. Tunda kelish, terrassada o‘tirish, qahva ichish, ovqatlanish va o‘zlariki orasida qolish mumkin. Food. Chill. Play. Coffee. Drinks. Take away.",
      "en": "PITSTOP brings together the auto/moto community and café atmosphere. Pull in at night, sit on the terrace, have coffee, eat, and stay among your people. Food. Chill. Play. Coffee. Drinks. Take away."
    },
    "menu_kicker": {
      "ru": "MENU",
      "uz": "MENU",
      "en": "MENU"
    },
    "menu_title": {
      "ru": "Кухня и бар",
      "uz": "Oshxona va bar",
      "en": "Kitchen and bar"
    },
    "menu_text": {
      "ru": "Завтраки с 03:00 до 15:00. Остальное меню — круглосуточно.",
      "uz": "Nonushta 03:00 dan 15:00 gacha. Qolgan menyu — kechayu kunduz.",
      "en": "Breakfast from 03:00 to 15:00. The rest of the menu is all day."
    },
